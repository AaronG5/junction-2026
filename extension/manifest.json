{
  "manifest_version": 3,
  "name": "Decode the Noise: potentially propaganda on X and Facebook",
  "short_name": "Decode the Noise",
  "version": "0.3.0",
  "description": "Marks X and Facebook posts that are potentially propaganda or show coordinated posting. Automated assessment, may be wrong.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.modal.run/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "file:///*/demo/feed.html*",
        "http://localhost/*feed.html*",
        "http://127.0.0.1/*feed.html*"
      ],
      "js": ["src/selectors.js", "src/parse.js", "src/view.js", "src/ui.js", "src/deep.js", "src/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["src/fb/page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["src/parse.js", "src/view.js", "src/ui.js", "src/deep.js", "src/fb/posts.js", "src/fb/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.woff2"],
      "matches": [
        "https://x.com/*", "https://*.x.com/*", "https://twitter.com/*", "https://*.twitter.com/*",
        "https://www.facebook.com/*", "https://web.facebook.com/*",
        "file:///*", "http://localhost/*", "http://127.0.0.1/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Decode the Noise",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
