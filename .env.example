# Copy of what the launcher generates in .env on first run (with random passwords).
# You normally never need to create this by hand.
BIND_HOST=127.0.0.1

MYSQL_DATABASE=veritas_lens
MYSQL_USER=veritas_lens
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
MYSQL_PORT=3306
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
LLAMA_SWAP_PORT=8080

# Where the dashboard gets its data (planned, see docs/data-architecture.md):
#   central = our server only, hybrid = local + central, local = fully offline.
# DATA_MODE=hybrid
# CENTRAL_API_URL=

# Chat model context window (tokens).
LLAMA_CTX_SIZE=16384
# Parallel request slots for the chat model.
# LLAMA_PARALLEL=1
# Extra llama-server flags appended to the chat model command line.
# LLAMA_EXTRA_ARGS=
# Store models somewhere else (e.g. a bigger disk).
# JUNCTION_MODELS_DIR=D:/junction-models

# Scrapers for "Analyze a link" (optional). Without keys, only posts already in
# the database can be analyzed. Oxylabs: Facebook and Telegram; context.dev: news sites.
# OXYLABS_USERNAME=
# OXYLABS_PASSWORD=
# CONTEXT_DEV_API_KEY=
# Data sourcing
OXYLABS_WEB_API_KEY=secretapikey
