    {
      "name": "Lithuanian letters match themselves",
      "text": "Pabėgėliai gauna didesnes išmokas",
      "query": "IŠMOKAS",
      "expected": true
    },
    {
      "name": "accents are significant: a does not match ą",
      "text": "Ką daryti",
      "query": "ka",
      "expected": false
    },
    {
      "name": "accents are significant: e does not match ė",
      "text": "Pabėgėliai",
      "query": "pabegeliai",
      "expected": false
    },
    {
      "name": "spaces inside the search are kept",
      "text": "NATO tanks",
      "query": "nato tanks",
      "expected": true
    },
    {
      "name": "spaces inside the search must match",
      "text": "NATO  tanks",
      "query": "nato tanks",
      "expected": false
    },
    {
      "name": "invisible byte-order mark is trimmed",
      "text": "NATO tanks",
      "query": "\ufeffnato",
      "expected": true
    }
