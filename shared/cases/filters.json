    {
      "name": "not found",
      "text": "NATO tanks",
      "query": "elections",
      "expected": false
    },
    {
      "name": "Cyrillic, case-insensitive",
      "text": "Танки НАТО снова провоцируют",
      "query": "нато",
      "expected": true
