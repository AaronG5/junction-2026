  "matchesQuery": [
    {
      "name": "empty search matches everything",
      "text": "NATO tanks at the border",
      "query": "",
      "expected": true
    },
    {
      "name": "only spaces matches everything",
      "text": "NATO tanks",
      "query": "   ",
      "expected": true
