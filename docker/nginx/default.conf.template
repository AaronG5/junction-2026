# The web proxy in front of the dashboard: everything that arrives on the
# default web port goes to the backend (BACKEND_PORT, 8000 by default), so the
# dashboard opens at http://<this computer>/ with no port number.
#
# Only the backend is proxied. The AI server (port 8080) keeps its own port on
# purpose: it has no login, so the default web port must not lead to it.
#
# The nginx image renders this file when the container starts: ${NGINX_LISTEN}
# and ${NGINX_UPSTREAM} come from docker-compose.yml, which the launcher fills
# in for this computer (local_ai/services.py, _nginx_env). Nothing else is
# substituted (NGINX_ENVSUBST_FILTER), so nginx's own $variables stay as they are.

# The dashboard is a React bundle and the backend compresses nothing itself.
gzip on;
gzip_proxied any;
gzip_min_length 1024;
gzip_types text/css text/javascript application/javascript application/json
           image/svg+xml application/manifest+json;

server {
    listen ${NGINX_LISTEN};
    server_name _;
    server_tokens off;

    # Articles pasted into the text box can be long; nothing here is an upload.
    client_max_body_size 4m;

    location / {
        proxy_pass http://${NGINX_UPSTREAM};
        proxy_http_version 1.1;

        # The backend checks the Host header (ALLOWED_HOSTS in .env), so it has
        # to see the name the browser used, not the address nginx connects to.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Analysing waits for the AI, which can take minutes; the default 60 s
        # would cut those requests off as 504s.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
